    {
      "parameters": {
        "toolDescription": "Analyzes raw customer reviews, clusters feedback, generates a <=250 word Weekly Product Pulse, and drafts a standardized fee explainer. Call this agent first whenever raw feedback or review data needs processing.",
        "text": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Prompt__User_Message_', ``, 'string') }}",
        "options": {
          "systemMessage": "You are a Senior Product Intelligence Specialist analyzing customer reviews from the past 8–12 weeks.\n\nYour deliverables:\n1. Cluster feedback into maximum 5 themes and rank the top 3 themes.\n2. Extract 3 verbatim customer quotes illustrating friction.\n3. Identify 1 recurring confusion or pain point regarding a fee or charge (e.g., recurring $20/month auto-renewal after uninstalling the mobile app).\n4. Generate a Weekly Product Pulse (strictly <= 250 words) with summary of themes, quotes, key observation, and 3 actionable ideas.\n5. Generate a Standardized Fee Explainer with <= 6 bullet points in a neutral tone, 2 official documentation links, and 'Last checked: [current date]'.\n\nYou may use the SerpAPI tool to verify official pricing policies and documentation URLs. Do not call the search tool more than 3 times."
        }
      },
      "id": "a2c5fc7a-3545-485b-a9bb-78de68c494a4",
